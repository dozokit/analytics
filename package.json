{
  "name": "dozokit-analytics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "seed": "node scripts/seed.mjs && wrangler d1 execute DB --local --file=.wrangler/seed.sql",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "flag-icons": "^7.6.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "license": "AGPL-3.0-only",
  "cloudflare": {
    "bindings": {
      "PASSWORD": {
        "description": "The password to sign in to your dashboard, 12 characters or more."
      },
      "DB": {
        "description": "Where the visits are kept."
      }
    }
  }
}
